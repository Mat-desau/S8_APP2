clc
clear all
close all

% Loader les images
Isource = imread("lenna.bmp");
[L1, C1] = size(Isource);

IsourceMod = (Isource(:,:,1)+Isource(:,:,2)+Isource(:,:,3))/3;

L2 = 256;
C2 = 256;

Iredim = zeros(L2, C2);

for l = 1 : L2-1
    for c = 1 : C2-1
        ll = floor(l*L1/L2);
        cc = floor(c*C1/C2);
        Iredim(l, c) = IsourceMod(ll, cc);
    end
end

% Pour montrer
figure(1)
imshow(IsourceMod);
figure(2)
imshow(uint8(Iredim))
